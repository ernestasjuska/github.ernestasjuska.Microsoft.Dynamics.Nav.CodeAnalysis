<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageOutputPath>C:\MY\NuGet\OfflinePackages</PackageOutputPath>
		<PackageId>github.ernestasjuska.Microsoft.Dynamics.Nav.CodeAnalysis</PackageId>
		<Version>0.0.1-beta202608291236</Version>
		<Authors>Ernestas Juška</Authors>
		<Description>Unofficial shipping of Microsoft.Dynamics.Nav.CodeAnalysis. Scope is limited to the .app package read/write surface (NavAppPackageReader, NavAppPackageWriter, NavAppManifest); the three declared package dependencies (Newtonsoft.Json, System.Collections.Immutable, System.IO.Packaging) are sufficient for that surface. Other namespaces exposed by the assembly (e.g. Microsoft.Dynamics.Nav.CodeAnalysis.Syntax, and the compilation and cop APIs) transitively require Microsoft.CodeAnalysis, Microsoft.CodeAnalysis.CSharp, Mono.Cecil, DocumentFormat.OpenXml, DocumentFormat.OpenXml.Framework, Microsoft.Security.AntiSSRF, and Microsoft.Dynamics.Nav.AL.Common. Those assemblies are NOT shipped or declared by this package (Microsoft.Dynamics.Nav.AL.Common is not published on nuget.org at all) and using those surfaces will throw FileNotFoundException at runtime.</Description>
		<RepositoryUrl>https://github.com/ernestasjuska/github.ernestasjuska.Microsoft.Dynamics.Nav.CodeAnalysis</RepositoryUrl>

    <!-- Don't pack the project output, only the copied dlls -->
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <BcToolsVersion>18.0.40.43394-beta</BcToolsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Collections.Immutable" Version="10.0.7" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.7" />
  </ItemGroup>

  <!-- Download the source package (not as a dependency) -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.Dynamics.BusinessCentral.Development.Tools" Version="[$(BcToolsVersion)]" />
  </ItemGroup>

  <!-- Copy DLL from downloaded NuGet package before pack, and register it for packing -->
  <Target Name="CopyNavCodeAnalysisDll" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <SourceDllPath>$(NuGetPackageRoot)\microsoft.dynamics.businesscentral.development.tools\$(BcToolsVersion)\tools\net8.0\any</SourceDllPath>
    </PropertyGroup>
    <ItemGroup>
      <NavCodeAnalysisDll Include="$(SourceDllPath)\Microsoft.Dynamics.Nav.CodeAnalysis.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NavCodeAnalysisDll)" DestinationFolder="lib\net8.0" SkipUnchangedFiles="true" />
    <!-- None items must be added inside the target so the glob resolves AFTER the copy -->
    <ItemGroup>
      <None Include="lib\net8.0\*.dll" Pack="true" PackagePath="lib\net8.0" />
    </ItemGroup>
  </Target>

</Project>
