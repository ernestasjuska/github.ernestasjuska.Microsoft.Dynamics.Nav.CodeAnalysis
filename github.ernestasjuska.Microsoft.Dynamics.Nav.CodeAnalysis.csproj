<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageOutputPath>C:\MY\NuGet\OfflinePackages</PackageOutputPath>
		<PackageId>github.ernestasjuska.Microsoft.Dynamics.Nav.CodeAnalysis</PackageId>
		<Version>0.0.1-beta202608291236</Version>
		<Authors>Ernestas Juška</Authors>
		<Description>Unofficial shipping of Microsoft.Dynamics.Nav.CodeAnalysis.</Description>
		<RepositoryUrl>https://github.com/ernestasjuska/github.ernestasjuska.Microsoft.Dynamics.Nav.CodeAnalysis</RepositoryUrl>

    <!-- Don't pack the project output, only the copied dlls -->
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <BcToolsVersion>18.0.40.43394-beta</BcToolsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Collections.Immutable" Version="10.0.7" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.7" />
  </ItemGroup>

  <!-- Download the source package (not as a dependency) -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.Dynamics.BusinessCentral.Development.Tools" Version="[$(BcToolsVersion)]" />
  </ItemGroup>

  <!-- Copy DLLs from downloaded NuGet package before pack, and register them for packing -->
  <Target Name="CopyNavCodeAnalysisDll" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <SourceDllPathNet8>$(NuGetPackageRoot)\microsoft.dynamics.businesscentral.development.tools\$(BcToolsVersion)\tools\net8.0\any</SourceDllPathNet8>
      <SourceDllPathNet10>$(NuGetPackageRoot)\microsoft.dynamics.businesscentral.development.tools\$(BcToolsVersion)\tools\net10.0\any</SourceDllPathNet10>
    </PropertyGroup>
    <ItemGroup>
      <NavCodeAnalysisDllNet8 Include="$(SourceDllPathNet8)\Microsoft.Dynamics.Nav.CodeAnalysis.dll" />
      <NavCodeAnalysisDllNet10 Include="$(SourceDllPathNet10)\Microsoft.Dynamics.Nav.CodeAnalysis.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NavCodeAnalysisDllNet8)" DestinationFolder="lib\net8.0" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NavCodeAnalysisDllNet10)" DestinationFolder="lib\net10.0" SkipUnchangedFiles="true" />
    <!-- None items must be added inside the target so the glob resolves AFTER the copy -->
    <ItemGroup>
      <None Include="lib\net8.0\*.dll" Pack="true" PackagePath="lib\net8.0" />
      <None Include="lib\net10.0\*.dll" Pack="true" PackagePath="lib\net10.0" />
    </ItemGroup>
  </Target>

</Project>
